generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PedidoEstado {
  CONFIRMED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  CASH
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  APPROVED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CheckoutSnapshotStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  FAILED
}

model Product {
  id          Int          @id @default(autoincrement())
  marca       String
  nombre      String
  precio      Decimal      @db.Decimal(10, 2)
  stock       Int
  imgUrl      String?
  cartItems   CartItem[]
  pedidoItems PedidoItem[]
  checkoutSnapshotItems CheckoutSnapshotItem[]
}

model User {
  id           Int      @id @default(autoincrement())
  usuario      String
  email        String   @unique
  passwordHash String
  cart         Cart?
  pedidos      Pedido[]
  checkoutSnapshots CheckoutSnapshot[]
}

model Cart {
  id     Int        @id @default(autoincrement())
  userId Int        @unique
  price  Decimal    @db.Decimal(10, 2)
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  productId Int
  cantidad  Int
  cart      Cart    @relation(fields: [cartId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Pedido {
  id               Int            @id @default(autoincrement())
  userId           Int
  nombre           String
  apellido         String
  dni              String
  telefono         String
  deliveryMethod   DeliveryMethod @default(PICKUP)
  calle            String?
  numero           String?
  localidad        String?
  codigoPostal     String?
  piso             String?
  departamento     String?
  especificaciones String?
  subtotal         Decimal        @default(0) @db.Decimal(10, 2)
  serviceFee       Decimal        @default(0) @db.Decimal(10, 2)
  deliveryFee      Decimal        @default(0) @db.Decimal(10, 2)
  total            Decimal        @default(0) @db.Decimal(10, 2)
  estado           PedidoEstado
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id])
  items            PedidoItem[]
  payment          Payment?
  checkoutSnapshot CheckoutSnapshot?
}

model PedidoItem {
  id        Int     @id @default(autoincrement())
  pedidoId  Int
  productId Int
  nombre    String
  marca     String
  cantidad  Int
  unitPrice Decimal @db.Decimal(10, 2)
  pedido    Pedido  @relation(fields: [pedidoId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id              Int           @id @default(autoincrement())
  pedidoId        Int           @unique
  method          PaymentMethod
  status          PaymentStatus
  providerOrderId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  pedido          Pedido        @relation(fields: [pedidoId], references: [id])
}

model CheckoutSnapshot {
  id               Int                    @id @default(autoincrement())
  userId           Int
  status           CheckoutSnapshotStatus @default(ACTIVE)
  providerOrderId  String?                @unique
  checkoutUrl      String?
  idempotencyKey   String?                @unique
  expiresAt        DateTime
  nombre           String
  apellido         String
  dni              String
  telefono         String
  deliveryMethod   DeliveryMethod
  calle            String?
  numero           String?
  localidad        String?
  codigoPostal     String?
  piso             String?
  departamento     String?
  especificaciones String?
  subtotal         Decimal                @db.Decimal(10, 2)
  serviceFee       Decimal                @db.Decimal(10, 2)
  deliveryFee      Decimal                @db.Decimal(10, 2)
  total            Decimal                @db.Decimal(10, 2)
  pedidoId         Int?                   @unique
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User                   @relation(fields: [userId], references: [id])
  pedido           Pedido?                @relation(fields: [pedidoId], references: [id])
  items            CheckoutSnapshotItem[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model CheckoutSnapshotItem {
  id                 Int              @id @default(autoincrement())
  checkoutSnapshotId Int
  productId          Int
  nombre             String
  marca              String
  cantidad           Int
  unitPrice          Decimal          @db.Decimal(10, 2)
  checkoutSnapshot   CheckoutSnapshot @relation(fields: [checkoutSnapshotId], references: [id])
  product            Product          @relation(fields: [productId], references: [id])
}

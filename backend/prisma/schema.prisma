generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PedidoEstado {
  PENDING
  CONFIRMED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  CASH
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Product {
  id          Int          @id @default(autoincrement())
  marca       String
  nombre      String
  precio      Decimal      @db.Decimal(10, 2)
  stock       Int
  imgUrl      String?
  cartItems   CartItem[]
  pedidoItems PedidoItem[]
}

model User {
  id           Int      @id @default(autoincrement())
  usuario      String
  email        String   @unique
  passwordHash String
  cart         Cart?
  pedidos      Pedido[]
}

model Cart {
  id     Int        @id @default(autoincrement())
  userId Int        @unique
  price  Decimal    @db.Decimal(10, 2)
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  productId Int
  cantidad  Int
  cart      Cart    @relation(fields: [cartId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Pedido {
  id               Int            @id @default(autoincrement())
  userId           Int
  nombre           String
  apellido         String
  dni              String
  telefono         String
  deliveryMethod   DeliveryMethod @default(PICKUP)
  calle            String?
  numero           String?
  localidad        String?
  codigoPostal     String?
  piso             String?
  departamento     String?
  especificaciones String?
  subtotal         Decimal        @default(0) @db.Decimal(10, 2)
  serviceFee       Decimal        @default(0) @db.Decimal(10, 2)
  deliveryFee      Decimal        @default(0) @db.Decimal(10, 2)
  total            Decimal        @default(0) @db.Decimal(10, 2)
  estado           PedidoEstado
  createdAt        DateTime       @default(now())
  expiresAt        DateTime?
  user             User           @relation(fields: [userId], references: [id])
  items            PedidoItem[]
  payment          Payment?
}

model PedidoItem {
  id        Int     @id @default(autoincrement())
  pedidoId  Int
  productId Int
  nombre    String
  marca     String
  cantidad  Int
  unitPrice Decimal @db.Decimal(10, 2)
  pedido    Pedido  @relation(fields: [pedidoId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id              Int           @id @default(autoincrement())
  pedidoId        Int           @unique
  method          PaymentMethod
  status          PaymentStatus
  providerOrderId String?
  idempotencyKey  String?       @unique
  checkoutUrl     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  pedido          Pedido        @relation(fields: [pedidoId], references: [id])
}
